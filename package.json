{
  "name": "alphapack-ts",
  "version": "1.0.0",
  "description": "Production-grade Telegram group management bot",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -R src/i18n dist/ && cp src/config/defaults.yaml dist/config/defaults.yaml",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node --max-old-space-size=256 dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/menu": "^1.5.0",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/storage-redis": "^2.6.0",
    "dotenv": "^16.6.1",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
