{
  "name": "alphapack-ts",
  "version": "1.0.0",
  "description": "Production-grade Telegram group management bot",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "start": "node --max-old-space-size=256 dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "grammy": "^1.45.1",
    "@grammyjs/i18n": "^1.1.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.3.1",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/storage-redis": "^2.6.0",
    "@grammyjs/runner": "^2.0.3",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3",
    "pino": "^10.3.1",
    "yaml": "^2.9.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "tsx": "^4.9.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
