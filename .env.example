BOT_TOKEN=
REDIS_URL=redis://127.0.0.1:6379
DEFAULT_LOCALE=id
NODE_ENV=production
LOG_LEVEL=info

# Custom name for the bot used in welcome, goodbye, rules, and guide templates.
# Defaults to the bot's Telegram first_name if omitted.
BOT_CUSTOM_NAME="Alpha Pack"

# ── Phase 7: Ops & Monitoring ────────────────────────────────────────────────

# OPS_CHANNEL_ID — Telegram channel ID (numeric, e.g. -100xxxxxxxxxx) that
# receives crash/error alerts and memory warnings. This is the bot OPERATOR's
# channel, not a per-group log channel. Leave empty to disable alerting.
OPS_CHANNEL_ID=

# OWNER_ID — Single Telegram user ID allowed to run /health. If unset,
# /health refuses everyone. This is deliberately NOT tied to group-admin status.
OWNER_ID=

# AUDIT_LOG_RETENTION_DAYS — Days to keep flat-file JSONL audit logs on disk.
# Files under logs/audit/ older than this are pruned daily. Default: 30.
AUDIT_LOG_RETENTION_DAYS=30